# Copy to .env (make setup does this). Never commit .env.

# --- LLM backend: bedrock (default) | openrouter | vertex | ollama ---
LLM_BACKEND=bedrock

# --- Claude in Amazon Bedrock (first option for all LLM calls) ---
# Bedrock API key (bearer token) from the Bedrock console -> API keys. Never commit it.
# If empty, the normal AWS credential chain (aws configure / SSO) is used instead.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# flash = most agent calls (cheap, fast); pro = TIER=pro / JUDGE=llm:pro
BEDROCK_MODEL_FLASH=anthropic.claude-haiku-5-5
BEDROCK_MODEL_PRO=anthropic.claude-opus-5-5
# low | medium | high | xhigh | max  (how much the model thinks; low keeps cost down)
BEDROCK_EFFORT=low

# --- OpenRouter (https://openrouter.ai/keys). `make models` lists model ids + prices. ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FLASH=google/gemini-3.8-flash
OPENROUTER_MODEL_PRO=google/gemini-3.1-pro-preview

# --- Google Cloud / Vertex AI (later; PLAN.txt section 8) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL_FLASH=
VERTEX_MODEL_PRO=

# --- Local model (project 1 step 11: LoRA judge) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Embeddings for the knowledge base (make kb). openrouter | vertex | local ---
EMBED_BACKEND=openrouter
EMBED_MODEL=baai/bge-m3
VERTEX_EMBED_MODEL=
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Retrieval: KB_MODE = hybrid | bm25 | dense ; KB_RERANK = none | llm
KB_MODE=hybrid
KB_RERANK=none

# --- Shared local models: the ONLY thing outside this folder, installed once for all projects ---
# Ollama keeps its models in ~/.ollama; fastembed models go here.
LOCAL_MODELS_DIR=~/.cache/agent-lab-models

# --- HTTP tools ---
# Wikipedia asks API clients for a descriptive User-Agent with a way to contact you
# (e.g. a GitHub URL or email), see https://meta.wikimedia.org/wiki/User-Agent_policy
HTTP_USER_AGENT=agent-lab/0.1 (personal research project; contact: <your GitHub URL or email>)
# Optional: free key from https://openalex.org/settings/api (own daily budget)
OPENALEX_API_KEY=

# --- Tracing (default: ./traces) ---
TRACE_DIR=
